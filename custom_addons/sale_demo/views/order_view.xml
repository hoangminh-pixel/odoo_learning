<odoo>

      <!-- FORM VIEW -->
      <record id="view_order_form" model="ir.ui.view">
            <field name="name">sale.demo.order.form</field>
            <field name="model">sale.demo.order</field>
            <field name="arch" type="xml">
                  <form string="Sale Order">
                        <sheet>
                              <group>
                                    <group>
                                          <field name="name"/>
                                          <field name="partner_id"/>
                                          <field name="date_order"/>
                                          <field name="state"/>
                                    </group>
                                    <group>
                                          <field name="name"/>
                                          <field name="partner_id"/>
                                          <field name="date_order"/>
                                          <field name="state"/>
                                    </group>
                              </group>



                              <notebook>
                                    <page string="Order Lines">
                                          <field name="line_ids" context="{'default_quantity':10}" >
                                                <tree editable="bottom">
                                                      <field name="product_name"/>
                                                      <field name="quantity"/>
                                                      <field name="price"/>
                                                      <field name="subtotal" readonly="1"/>
                                                </tree>
                                          </field>
                                    </page>
                              </notebook>
                        </sheet>
                  </form>
            </field>
      </record>

      <!-- TREE VIEW -->
      <record id="view_order_tree" model="ir.ui.view">
            <field name="name">sale.demo.order.tree</field>
            <field name="model">sale.demo.order</field>
            <field name="arch" type="xml">
                  <tree>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="date_order"/>
                        <field name="state"/>
                        <button name="action_open_detail" type="object" string="Detail" class="btn-primary"/>
                  </tree>
            </field>
      </record>

      <!-- ACTION -->
      <record id="action_sale_demo_order" model="ir.actions.act_window">
            <field name="name">Sale Orders</field>
            <field name="res_model">sale.demo.order</field>
            <field name="view_mode">tree,form</field>
      </record>

      <record id="action_sale_demo_order_tree" model="ir.actions.act_window">
            <field name="name">Sale Orders (List)</field>
            <field name="res_model">sale.demo.order</field>
            <field name="view_mode">tree</field>
            <!-- <field name="domain">[('state','=','done')]</field> -->
      </record>



      <!-- MENU -->
      <menuitem id="menu_sale_demo_root" name="Sale Demo"/>
      <menuitem id="menu_sale_demo_order" name="Orders" parent="menu_sale_demo_root" action="action_sale_demo_order" />

      <menuitem id="menu_sale_demo_order_list" name="Orders (List)" parent="menu_sale_demo_root" action="action_sale_demo_order_tree" />

      <menuitem id="menu_sale_demo_report_order" name="Order Report" parent="menu_sale_demo_order_list" action="action_sale_demo_order_tree" />

</odoo>
